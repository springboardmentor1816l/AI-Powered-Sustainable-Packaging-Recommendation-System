# .env.example — copy to .env and fill with real values (DO NOT commit .env)

# PostgreSQL
POSTGRES_HOST=ecopack_postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecopackai_db
POSTGRES_USER=ecopack
POSTGRES_PASSWORD=changeme

# Optionally provide DATABASE_URL (overrides individual DB_* vars)
# DATABASE_URL=postgresql://ecopack:changeme@ecopack_postgres:5432/ecopackai_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@ecopack.ai
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# App environment
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_long_random_string

# (Optional) other service credentials if any (S3, API keys) — set them here or in GitHub Secrets
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
