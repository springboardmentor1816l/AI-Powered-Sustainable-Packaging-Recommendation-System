import pandas as pd
import numpy as np
import os
import sys

# --- FILE PATHS (Adjust these paths if necessary) ---
# Input files
MATERIALS_INPUT_PATH = 'materials_final_engineered.csv' # Used here to get the final TARGETS
PRODUCTS_INPUT_PATH = 'product_dataset.csv'             # Raw product file

# Output Deliverables (To be used in the next notebook)
X_RAW_OUTPUT_PATH = 'X_raw.csv'
Y_RAW_OUTPUT_PATH = 'y_raw.csv'

# --- CORE DEFINITIONS ---
TARGET_COST = 'Cost_Efficiency_Index'
TARGET_CO2 = 'CO2_Impact_Index'
EXCLUSION_LIST = ['Material ID', 'product_id', 'product_name', TARGET_COST, TARGET_CO2]
ENGINEERED_COLS = ['Material_Suitability_Score'] # Drop engineered features to keep X raw

# List of RAW features for final selection (based on previous project steps)
RAW_MATERIAL_INPUTS = [
    'strength_mpa', 'weight_capacity', 'biodegradability_percent', 
    'co2_emission_score', 'recyclability_percent', 'cost_per_kg', 
    'material_type', 'industry_use_case'
]
RAW_PRODUCT_INPUTS = [
    'product_weight_kg', 'fragility_index', 'category', 'shipping_type'
]


# =================================================================
# NOTEBOOK SECTION 1: Load the Raw Integrated Dataset
# =================================================================
print("# Notebook 01: Raw Dataset Preparation and Feature/Target Definition")
print("\n## 1. Load the Raw Integrated Dataset")

try:
    df_materials = pd.read_csv(MATERIALS_INPUT_PATH)
    df_products = pd.read_csv(PRODUCTS_INPUT_PATH)

    # Cross-Join to create the integrated dataset structure
    df_materials['key'] = 1
    df_products['key'] = 1
    df_integrated = pd.merge(df_products, df_materials, on='key', how='cross').drop('key', axis=1)
    
    print("\nIntegrated Dataset Info:")
    df_integrated.info()
    
    print("\nIntegrated Dataset Head (Sample):")
    print(df_integrated.head(3).to_markdown(index=False))

    print("\nMissing Values Check (Target Columns - Should be zero post-FE):")
    # This check ensures the engineered targets are ready
    print(df_integrated[[TARGET_COST, TARGET_CO2]].isnull().sum().to_markdown())

except FileNotFoundError as e:
    print(f"\nERROR: Required input file not found: {e}. Cannot run the notebook.")
    sys.exit(1)


# =================================================================
# NOTEBOOK SECTION 2: Select Final Target Variables
# =================================================================
print("\n## 2. Select Final Target Variables")

y_raw = df_integrated[[TARGET_COST, TARGET_CO2]]
print(f"\ny_raw shape: {y_raw.shape}")
print("y_raw (Targets) Head:")
print(y_raw.head().to_markdown())


# =================================================================
# NOTEBOOK SECTION 3 & 4: Select & Organize Features (X_raw)
# =================================================================
print("\n## 3. Select & Organize Raw Features (X_raw)")

# Combine all desired raw feature columns
RAW_FEATURE_COLS_FINAL = RAW_MATERIAL_INPUTS + RAW_PRODUCT_INPUTS

# Filter the integrated dataframe to include ONLY the raw feature columns
X_raw = df_integrated[[col for col in RAW_FEATURE_COLS_FINAL if col in df_integrated.columns]]

print(f"\nX_raw shape (Features before scaling/encoding): {X_raw.shape}")
print("X_raw (Features) Head:")
print(X_raw.head().to_markdown(index=False))


# =================================================================
# NOTEBOOK SECTION 5: Output Files
# =================================================================
print("\n## 4. Output Files & Data Dictionary Update")

# Save X_raw
X_raw.to_csv(X_RAW_OUTPUT_PATH, index=False)
# Save y_raw
y_raw.to_csv(Y_RAW_OUTPUT_PATH, index=False)

print(f"\n[OUTPUT] X_raw (Raw Features) saved to: {X_RAW_OUTPUT_PATH}")
print(f"[OUTPUT] y_raw (Targets) saved to: {Y_RAW_OUTPUT_PATH}")

print("\n**Data Dictionary Update Note:** The 'Features & Targets' section is updated to formalize X_raw and y_raw definitions based on these saved files.")